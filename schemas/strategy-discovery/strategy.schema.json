{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stockvision://strategy-discovery/strategy-v1",
  "type": "object",
  "required": ["strategy_id", "version", "name", "hypothesis", "feature_ids", "entry_rules", "exit_rules", "holding_period", "execution_timing", "transaction_cost", "preferred_regimes", "failure_regimes", "annual_performance", "regime_performance", "factor_exposure", "signal_correlation", "selection_overlap", "known_failures", "source_references", "governance"],
  "properties": {
    "strategy_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "feature_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "entry_rules": { "type": "array" },
    "exit_rules": { "type": "array" },
    "holding_period": { "type": "string" },
    "execution_timing": { "type": "string" },
    "transaction_cost": { "oneOf": [{ "type": "object" }, { "const": "UNKNOWN" }] },
    "preferred_regimes": { "type": "array", "items": { "type": "string" } },
    "failure_regimes": { "type": "array", "items": { "type": "string" } },
    "annual_performance": { "type": "object" },
    "regime_performance": { "type": "object" },
    "factor_exposure": { "type": "object" },
    "signal_correlation": { "type": "object" },
    "selection_overlap": { "type": "object" },
    "known_failures": { "type": "array", "items": { "type": "string" } },
    "source_references": { "type": "array", "items": { "type": "string" } },
    "governance": { "type": "object", "required": ["status", "owner_type", "promotion_status", "alpha_bucket", "family_id", "variant_id"] }
  },
  "additionalProperties": false
}
