{
 "apiVersion": 1,
 "groups": [
  {
   "orgId": 1,
   "name": "sv-chain",
   "folder": "StockVision",
   "interval": "1m",
   "rules": [
    {
     "uid": "sv-chain-failed",
     "title": "流程鏈：有階段失敗",
     "condition": "C",
     "for": "0s",
     "isPaused": true,
     "noDataState": "OK",
     "execErrState": "Error",
     "labels": {
      "severity": "critical",
      "system": "stockvision",
      "source": "monitoring-worker"
     },
     "annotations": {
      "summary": "四條鏈（每日、盤中、每週、每月）有階段以 error 結束（含只看失敗的階段）。看「今天」頁的要處理清單（有鏈別）。",
      "dashboard": "/d/sv-today"
     },
     "data": [
      {
       "refId": "A",
       "relativeTimeRange": {
        "from": 600,
        "to": 0
       },
       "datasourceUid": "sv-monitoring",
       "model": {
        "refId": "A",
        "type": "json",
        "parser": "backend",
        "format": "table",
        "root_selector": "([{ 'n': counts.failed }])",
        "columns": [
         {
          "selector": "n",
          "text": "n",
          "type": "number"
         }
        ],
        "filters": [],
        "datasource": {
         "type": "yesoreyeram-infinity-datasource",
         "uid": "sv-monitoring"
        },
        "source": "url",
        "url": "/v1/chain/alerts",
        "url_options": {
         "method": "GET",
         "data": ""
        }
       }
      },
      {
       "refId": "B",
       "relativeTimeRange": {
        "from": 600,
        "to": 0
       },
       "datasourceUid": "__expr__",
       "model": {
        "refId": "B",
        "type": "reduce",
        "datasource": {
         "type": "__expr__",
         "uid": "__expr__"
        },
        "expression": "A",
        "reducer": "last"
       }
      },
      {
       "refId": "C",
       "relativeTimeRange": {
        "from": 600,
        "to": 0
       },
       "datasourceUid": "__expr__",
       "model": {
        "refId": "C",
        "type": "threshold",
        "datasource": {
         "type": "__expr__",
         "uid": "__expr__"
        },
        "expression": "B",
        "conditions": [
         {
          "evaluator": {
           "type": "gt",
           "params": [
            0
           ]
          }
         }
        ]
       }
      }
     ]
    },
    {
     "uid": "sv-chain-overdue",
     "title": "流程鏈：必要階段逾時或卡住",
     "condition": "C",
     "for": "2m",
     "isPaused": true,
     "noDataState": "OK",
     "execErrState": "Error",
     "labels": {
      "severity": "critical",
      "system": "stockvision",
      "source": "monitoring-worker"
     },
     "annotations": {
      "summary": "必要階段過了截止還沒完成；或執行中但 heartbeat 停了超過 15 分鐘；或盤中 intraday-check 超過 10 分鐘沒有新結果。",
      "dashboard": "/d/sv-today"
     },
     "data": [
      {
       "refId": "A",
       "relativeTimeRange": {
        "from": 600,
        "to": 0
       },
       "datasourceUid": "sv-monitoring",
       "model": {
        "refId": "A",
        "type": "json",
        "parser": "backend",
        "format": "table",
        "root_selector": "([{ 'n': counts.overdue + counts.stuck }])",
        "columns": [
         {
          "selector": "n",
          "text": "n",
          "type": "number"
         }
        ],
        "filters": [],
        "datasource": {
         "type": "yesoreyeram-infinity-datasource",
         "uid": "sv-monitoring"
        },
        "source": "url",
        "url": "/v1/chain/alerts",
        "url_options": {
         "method": "GET",
         "data": ""
        }
       }
      },
      {
       "refId": "B",
       "relativeTimeRange": {
        "from": 600,
        "to": 0
       },
       "datasourceUid": "__expr__",
       "model": {
        "refId": "B",
        "type": "reduce",
        "datasource": {
         "type": "__expr__",
         "uid": "__expr__"
        },
        "expression": "A",
        "reducer": "last"
       }
      },
      {
       "refId": "C",
       "relativeTimeRange": {
        "from": 600,
        "to": 0
       },
       "datasourceUid": "__expr__",
       "model": {
        "refId": "C",
        "type": "threshold",
        "datasource": {
         "type": "__expr__",
         "uid": "__expr__"
        },
        "expression": "B",
        "conditions": [
         {
          "evaluator": {
           "type": "gt",
           "params": [
            0
           ]
          }
         }
        ]
       }
      }
     ]
    },
    {
     "uid": "sv-chain-missed",
     "title": "流程鏈：該跑的鏈沒有起跑",
     "condition": "C",
     "for": "0s",
     "isPaused": true,
     "noDataState": "OK",
     "execErrState": "Error",
     "labels": {
      "severity": "critical",
      "system": "stockvision",
      "source": "monitoring-worker"
     },
     "annotations": {
      "summary": "過了第一站截止還沒有任何狀態列：每日 18:30、盤中 09:10（交易日）、每週週五 19:00、每月第一個週六 13:00。前一期也沒資料時（剛上線）不算。",
      "dashboard": "/d/sv-today"
     },
     "data": [
      {
       "refId": "A",
       "relativeTimeRange": {
        "from": 600,
        "to": 0
       },
       "datasourceUid": "sv-monitoring",
       "model": {
        "refId": "A",
        "type": "json",
        "parser": "backend",
        "format": "table",
        "root_selector": "([{ 'n': counts.missed }])",
        "columns": [
         {
          "selector": "n",
          "text": "n",
          "type": "number"
         }
        ],
        "filters": [],
        "datasource": {
         "type": "yesoreyeram-infinity-datasource",
         "uid": "sv-monitoring"
        },
        "source": "url",
        "url": "/v1/chain/alerts",
        "url_options": {
         "method": "GET",
         "data": ""
        }
       }
      },
      {
       "refId": "B",
       "relativeTimeRange": {
        "from": 600,
        "to": 0
       },
       "datasourceUid": "__expr__",
       "model": {
        "refId": "B",
        "type": "reduce",
        "datasource": {
         "type": "__expr__",
         "uid": "__expr__"
        },
        "expression": "A",
        "reducer": "last"
       }
      },
      {
       "refId": "C",
       "relativeTimeRange": {
        "from": 600,
        "to": 0
       },
       "datasourceUid": "__expr__",
       "model": {
        "refId": "C",
        "type": "threshold",
        "datasource": {
         "type": "__expr__",
         "uid": "__expr__"
        },
        "expression": "B",
        "conditions": [
         {
          "evaluator": {
           "type": "gt",
           "params": [
            0
           ]
          }
         }
        ]
       }
      }
     ]
    },
    {
     "uid": "sv-data-not-ready",
     "title": "資料就緒：該到的資料沒到",
     "condition": "C",
     "for": "15m",
     "isPaused": true,
     "noDataState": "OK",
     "execErrState": "Error",
     "labels": {
      "severity": "warning",
      "system": "stockvision",
      "source": "monitoring-worker"
     },
     "annotations": {
      "summary": "價格、籌碼、技術指標或首頁資料匯入有 fail。看「今天」頁的資料就緒表。",
      "dashboard": "/d/sv-today"
     },
     "data": [
      {
       "refId": "A",
       "relativeTimeRange": {
        "from": 600,
        "to": 0
       },
       "datasourceUid": "sv-monitoring",
       "model": {
        "refId": "A",
        "type": "json",
        "parser": "backend",
        "format": "table",
        "root_selector": "([{ 'n': $count(checks[status = 'fail']) }])",
        "columns": [
         {
          "selector": "n",
          "text": "n",
          "type": "number"
         }
        ],
        "filters": [],
        "datasource": {
         "type": "yesoreyeram-infinity-datasource",
         "uid": "sv-monitoring"
        },
        "source": "url",
        "url": "/v1/data-readiness",
        "url_options": {
         "method": "GET",
         "data": ""
        }
       }
      },
      {
       "refId": "B",
       "relativeTimeRange": {
        "from": 600,
        "to": 0
       },
       "datasourceUid": "__expr__",
       "model": {
        "refId": "B",
        "type": "reduce",
        "datasource": {
         "type": "__expr__",
         "uid": "__expr__"
        },
        "expression": "A",
        "reducer": "last"
       }
      },
      {
       "refId": "C",
       "relativeTimeRange": {
        "from": 600,
        "to": 0
       },
       "datasourceUid": "__expr__",
       "model": {
        "refId": "C",
        "type": "threshold",
        "datasource": {
         "type": "__expr__",
         "uid": "__expr__"
        },
        "expression": "B",
        "conditions": [
         {
          "evaluator": {
           "type": "gt",
           "params": [
            0
           ]
          }
         }
        ]
       }
      }
     ]
    },
    {
     "uid": "sv-d1-capacity",
     "title": "D1 容量：使用率 ≥ 80% 或 30 天內會滿",
     "condition": "C",
     "for": "30m",
     "isPaused": true,
     "noDataState": "OK",
     "execErrState": "Error",
     "labels": {
      "severity": "warning",
      "system": "stockvision",
      "source": "monitoring-worker"
     },
     "annotations": {
      "summary": "有 D1 資料庫使用率達 80%，或依成長速度 30 天內會到 90%。看「資源與模型」頁的容量表。",
      "dashboard": "/d/sv-today"
     },
     "data": [
      {
       "refId": "A",
       "relativeTimeRange": {
        "from": 600,
        "to": 0
       },
       "datasourceUid": "sv-monitoring",
       "model": {
        "refId": "A",
        "type": "json",
        "parser": "backend",
        "format": "table",
        "root_selector": "([{ 'n': $count(rows[utilization_pct >= 80]) + $count(rows[projected_days_to_critical_90pct != null][projected_days_to_critical_90pct <= 30]) }])",
        "columns": [
         {
          "selector": "n",
          "text": "n",
          "type": "number"
         }
        ],
        "filters": [],
        "datasource": {
         "type": "yesoreyeram-infinity-datasource",
         "uid": "sv-monitoring"
        },
        "source": "url",
        "url": "/v1/capacity",
        "url_options": {
         "method": "GET",
         "data": ""
        }
       }
      },
      {
       "refId": "B",
       "relativeTimeRange": {
        "from": 600,
        "to": 0
       },
       "datasourceUid": "__expr__",
       "model": {
        "refId": "B",
        "type": "reduce",
        "datasource": {
         "type": "__expr__",
         "uid": "__expr__"
        },
        "expression": "A",
        "reducer": "last"
       }
      },
      {
       "refId": "C",
       "relativeTimeRange": {
