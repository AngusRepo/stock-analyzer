{
  "schema_version": "stockvision-alpha-mining-promotion-contract-v1",
  "owner": "alpha_mining_research",
  "decision_effect": "governance_contract_only",
  "source_contracts": {
    "feature_registry": "data/feature_registry/unified_feature_registry_v1.json",
    "monthly_mining_config": "data/feature_registry/pymoo_monthly_mining_config_v1.json",
    "similarity_contract": "data/feature_registry/formal137_similarity_contract_v1.json",
    "similarity_pairs": "output/feature_universe_triage/formal137_pairwise_similarity_long_20260617.csv",
    "strategy_feature_ref_contract": "data/feature_registry/strategy_feature_ref_contract_v1.json",
    "ml_feature_selection_contract": "data/feature_registry/ml_feature_selection_contract_v1.json",
    "current_alpha_miner_seed_migration": "worker/migration_strategy_registry_alpha_miner_2026_06_17.sql",
    "strategy_mining_ledger_migration": "worker/migration_strategy_mining_ledger_2026_06_18.sql"
  },
  "feature_pool_policy": {
    "formal_pool": "137 = 69 core_prior + 68 evidence_watch",
    "selector_role_counts": {
      "evidence_watch": 68,
      "core_prior": 69,
      "drop_research_candidate": 43,
      "alias": 35,
      "transform_candidate": 82,
      "context_only": 410,
      "chip_candidate": 4,
      "drop": 191
    },
    "eligible_for_alpha_mining": 137,
    "core_prior": "Can seed challenger evidence directly when FinLab and walk-forward evidence pass.",
    "evidence_watch": "Can enter pymoo combinations with lower prior; cannot directly seed challenger without a passing mined combo.",
    "drop_research_candidate": "Excluded from selector, ML, PLE and alpha mining candidate paths.",
    "lineage_only": "179 is historical lineage only; monthly mining must use the formal 137 pool."
  },
  "monthly_search_policy": {
    "cadence": "monthly",
    "recommended_window": "first Saturday 10:00 Asia/Taipei after feature materialization audit and before monthly Optuna/retrain",
    "requires_finlab_backtest": true,
    "algorithm": "pymoo",
    "factor_universe": "unified_registry_v1",
    "initial_defaults": {
      "min_factors": 2,
      "max_factors": 8,
      "pymoo_population": 48,
      "pymoo_generations": 6,
      "finlab_confirm_top_n": 8
    },
    "adaptive_controller": {
      "enabled_after_first_telemetry": true,
      "inputs": [
        "accepted_candidate_count",
        "family_count",
        "median_novelty",
        "median_similarity_penalty",
        "median_max_similarity",
        "pbo_failure_rate",
        "runtime_seconds",
        "previous_run_outputs"
      ],
      "population_bounds": [
        32,
        128
      ],
      "generation_bounds": [
        4,
        16
      ],
      "max_factors_bounds": [
        4,
        10
      ],
      "mutation_rate_bounds": [
        0.08,
        0.35
      ],
      "rule": "Start from the previous completed run's actual population/generations/top_n (not the static defaults). Increase exploration when accepted candidates are low; shrink when survivors are ample; reduce generations/top_n under PBO failure or runtime pressure. Every extra trial raises the cumulative effective-trial DSR hurdle."
    },
    "research_protocol": {
      "schema_version": "strategy-mining-research-protocol-v3",
      "window_mode": "rolling",
      "train_sessions": 504,
      "validation_sessions": 252,
      "holdout_sessions": 126,
      "purge_sessions": 21,
      "embargo_sessions": 5,
      "holdout_not_before": "2026-11-08",
      "holdout_not_before_reason": "runs up to 2026-11-07 optimised and gated on 2026-01-01..run date; that data is burned as a holdout",
      "min_holdout_sessions_for_gate": 60,
      "execution_lag_sessions": 1,
      "fill_price": "close",
      "commission_rate": 0.001425,
      "sell_tax_rate": 0.003,
      "benchmark": "tradable_universe_equal_weight",
      "min_factor_weight_coverage": 0.5,
      "cross_sectional_min_varying_date_ratio": 0.5,
      "direction_ic_horizon_sessions": 21,
      "label_signature_date_stride": 5,
      "novelty_neighbours": 10,
      "feature_triage_window": {
        "start": "2023-01-01",
        "end": "2026-06-15"
      },
      "selection_gate": {
        "min_validation_excess_sharpe": 0.75,
        "min_train_excess_sharpe": 0.0,
        "min_deflated_sharpe_probability": 0.95,
        "max_selection_drawdown": 0.35,
        "max_turnover": 0.95,
        "regime_min_observations": 40,
        "regime_min_excess_return_annualized": -0.15
      },
      "holdout_gate": {
        "holm_alpha": 0.05,
        "regime_min_observations": 20,
        "regime_min_excess_return_annualized": -0.15,
        "finlab_confirm_min_monthly_sharpe": 0.5,
        "finlab_confirm_require_positive_alpha": true
      }
    },
    "novelty_contract": {
      "base": "kNN candidate-to-archive formal137 similarity (mean of the nearest neighbours)",
      "adjusted": "formal137 pairwise abs rank corr; missing pairs count as duplicates (fail closed)",
      "high_duplicate_floor": "nearest abs rank corr >= 0.8",
      "related_cluster_floor": "0.4 <= nearest abs rank corr < 0.8"
    }
  },
  "promotion_lifecycle": [
    {
      "state": "research_candidate",
      "owner": "alpha_mining_research",
      "entry": "Generated by monthly pymoo NSGA-III + novelty from formal feature pool.",
      "decision_effect": "none",
      "allowed_writes": [
        "research artifact",
        "summary report"
      ]
    },
    {
      "state": "challenger_candidate",
      "owner": "strategy_governance",
      "entry": "Representative mined family has passing FinLab confirm, PBO/deflated Sharpe, novelty telemetry and walk-forward evidence.",
      "decision_effect": "research registry only",
      "allowed_writes": [
        "promotion packet",
        "D1 research/challenger metadata"
      ]
    },
    {
      "state": "paper_active",
      "owner": "strategy_governance",
      "entry": "Requires explicit Wei approval after challenger packet review.",
      "decision_effect": "paper/live-observe evidence only",
      "allowed_writes": [
        "paper/replay evidence"
      ]
    },
    {
      "state": "production",
      "owner": "strategy_registry",
      "entry": "Requires explicit Wei approval, migration/registry write, and clean rollback path.",
      "decision_effect": "L1 strategy labeler active spec",
      "allowed_writes": [
        "strategy_spec_registry"
      ]
    },
    {
      "state": "retired",
      "owner": "strategy_governance",
      "entry": "Triggered by degradation, high overlap with stronger strategy, stale evidence, or explicit Wei decision.",
      "decision_effect": "removed from runtime active strategy set",
      "allowed_writes": [
        "strategy_spec_registry"
      ]
    }
  ],
  "required_evidence": [
    "finlab_confirm_backtest",
    "walk_forward_validation",
    "pbo",
    "deflated_sharpe_probability",
    "formal137_similarity_novelty",
    "strategy_feature_ref_validation",
    "l1_5_diversity_compare",
    "l2_l3_retention_compare",
    "l4_buy_stability_compare",
    "live_vs_backtest_divergence_after_observe",
    "sealed_holdout_evaluated_once_for_gate_finalists",
    "holm_family_includes_prior_overlapping_holdouts",
    "cumulative_effective_trial_count",
    "benchmark_relative_beta_and_regime_breakdown",
    "recorded_factor_directions"
  ],
  "promotion_guardrails": {
    "no_direct_daily_buy_path": true,
    "no_top_k_fallback": true,
    "no_new_selector": true,
    "no_201_or_179_feature_soup": true,
    "explicit_wei_approval_required_for_production": true,
    "d1_strategy_registry_is_source_of_truth_after_seed": true,
    "strategy_code_bootstrap_limit": "D1 strategy_spec_registry is the runtime source-of-truth; DEFAULT_STRATEGY_SPECS is bootstrap seed only and must not serve as runtime fallback."
  },
  "ledger_contract": {
    "migration": "worker/migration_strategy_mining_ledger_2026_06_18.sql",
    "tables": [
      "strategy_mining_runs",
      "strategy_mining_candidates",
      "strategy_backtest_results",
      "active_strategy_backtest_results",
      "strategy_similarity_matrix",
      "strategy_promotion_ledger"
    ],
    "decision_effect": "research_and_governance_until_explicit_production_promotion",
    "real_trading_effect": "none"
  },
  "current_explicit_seed": {
    "seeded_strategy_ids": [
      "alpha_miner_pymoo_nsga3_novelty_0081",
      "alpha_miner_pymoo_nsga3_novelty_0187",
      "alpha_miner_pymoo_nsga3_novelty_0193"
    ],
    "source": "worker/migration_strategy_registry_alpha_miner_2026_06_17.sql",
    "note": "Current 3 mined strategies were handled as explicitly approved 2026-06-17 seed; future monthly mined strategies must follow this contract."
  }
}