     "timeSeriesList": {
      "projectName": "gen-lang-client-0602998820",
      "filters": [
       "resource.type",
       "=",
       "cloud_run_job",
       "AND",
       "metric.type",
       "=",
       "run.googleapis.com/job/running_executions"
      ],
      "crossSeriesReducer": "REDUCE_SUM",
      "perSeriesAligner": "ALIGN_SUM",
      "alignmentPeriod": "+86400s",
      "groupBys": [
       "resource.label.job_name"
      ]
     },
     "aliasBy": "{{resource.label.job_name}}"
    }
   ],
