{
  "schema_version": 1,
  "project_id": "gen-lang-client-0602998820",
  "region": "asia-east1",
  "timezone": "Asia/Taipei",
  "artifact_registry_repository": "cloud-run-source-deploy",
  "scaler_service_account": "cloud-run-scaler@gen-lang-client-0602998820.iam.gserviceaccount.com",
  "delete_schedule_ids": ["ml-controller-min-1-evening"],
  "service_policies": {
    "ml-controller": {
      "cpu": "4",
      "memory": "4Gi",
      "concurrency": 40,
      "timeout_seconds": 3600,
      "cpu_allocation": "request_only",
      "default_min": 0,
      "max": 5,
      "warm_enabled": true
    },
    "shioaji-proxy": {
      "cpu": "1",
      "memory": "512Mi",
      "concurrency": 4,
      "timeout_seconds": 15,
      "cpu_allocation": "continuous",
      "default_min": 0,
      "max": 1,
      "warm_enabled": true,
      "warm_reason": "persistent broker session, subscriptions, tick cache, watchdog"
    },
    "shioaji-research": {
      "cpu": "1",
      "memory": "1Gi",
      "concurrency": 1,
      "timeout_seconds": 120,
      "cpu_allocation": "request_only",
      "default_min": 0,
      "max": 20,
      "warm_enabled": false,
      "warm_reason": "request-scoped research bars with bounded service autoscaling"
    },
    "stockvision-execution-gateway": {
      "cpu": "1",
      "memory": "1Gi",
      "concurrency": 1,
      "timeout_seconds": 10,
      "cpu_allocation": "continuous",
      "default_min": 0,
      "max": 1,
      "warm_enabled": false,
      "warm_enable_contract": "FINLAB_LIVE_SUBMIT_ENABLED=1 or LIVE_EXECUTION_SHADOW_BROKER_READ_ENABLED=1",
      "warm_reason": "continuous CPU remains a future safety invariant; disabled execution has no background owner"
    }
  },
  "scaler_jobs": {
    "ml-controller-min-1": {
      "services": ["ml-controller"],
      "desired_min": 1,
      "calendar_gate": "none"
    },
    "ml-controller-min-0": {
      "services": ["ml-controller"],
      "desired_min": 0,
      "calendar_gate": "none"
    },
    "ml-controller-monthly-min-1": {
      "services": ["ml-controller"],
      "desired_min": 1,
      "calendar_gate": "first_saturday_only"
    },
    "ml-controller-monthly-min-0": {
      "services": ["ml-controller"],
      "desired_min": 0,
      "calendar_gate": "first_saturday_only"
    },
    "realtime-runtime-min-1": {
      "services": ["shioaji-proxy"],
      "desired_min": 1,
      "calendar_gate": "twse_fail_open_min_1"
    },
    "realtime-runtime-min-0": {
      "services": ["shioaji-proxy"],
      "desired_min": 0,
      "calendar_gate": "none"
    }
  },
  "schedules": [
    {"name": "realtime-runtime-min-1-trading-open", "job": "realtime-runtime-min-1", "cron": "30 8 * * 1-5"},
    {"name": "realtime-runtime-min-0-trading-close", "job": "realtime-runtime-min-0", "cron": "31 13 * * 1-5"},
    {"name": "ml-controller-min-1-trading-open", "job": "ml-controller-min-1", "cron": "40 8 * * 1-5"},
    {"name": "ml-controller-min-0-trading-midday", "job": "ml-controller-min-0", "cron": "40 13 * * 1-5"},
    {"name": "ml-controller-min-0-night", "job": "ml-controller-min-0", "cron": "0 0 * * 2-6"},
    {"name": "ml-controller-min-1-monthly-sat", "job": "ml-controller-monthly-min-1", "cron": "first saturday of month 09:50"},
    {"name": "ml-controller-min-0-monthly-sat", "job": "ml-controller-monthly-min-0", "cron": "first saturday of month 16:30"},
    {"name": "ml-controller-min-1-sunday-research", "job": "ml-controller-min-1", "cron": "0 1 * * 0"},
    {"name": "ml-controller-min-0-sunday-research", "job": "ml-controller-min-0", "cron": "0 7 * * 0"}
  ],
  "evening_window_policy": {
    "enabled": false,
    "classification": "retired_low_value_warm_window",
    "reason": "callback correctness is durable queue owned and the weekday evening warm window is not a correctness dependency",
    "reassess_after_successful_native_chains": 10
  },
  "trading_warm_window_policy": {
    "schema_version": "ml-controller-trading-warm-window-v2",
    "window": "08:40-13:40 Asia/Taipei weekdays",
    "source": "cloud_run_request_logs",
    "observed_period": "2026-08-13..2026-08-26",
    "late_window": "13:40-13:59 Asia/Taipei",
    "late_window_request_days": 1,
    "late_window_request_classification": "manual_or_research_non_correctness_path",
    "correctness_owner": "durable_queue_and_terminal_receipt",
    "estimated_monthly_saving_usd": 0.5,
    "rollback": {
      "restore_cron": "0 14 * * 1-5",
      "condition": "scheduled_production_request_after_13:40_or_cold_start_p95_slo_regression"
    }
  }
}
