      {
       "selector": "k",
       "text": "k",
       "type": "number"
      },
      {
       "selector": "v",
       "text": "vA",
       "type": "number"
      }
     ],
     "filters": [],
     "datasource": {
      "type": "yesoreyeram-infinity-datasource",
      "uid": "sv-monitoring"
     },
     "source": "url",
     "url": "/v1/chain/state",
     "url_options": {
      "method": "GET",
      "data": ""
     }
    },
    {
     "refId": "B",
     "type": "json",
     "parser": "backend",
     "format": "table",
     "root_selector": "([{ 'k': 1, 'v': counts.total > 0 ? 1 : 0 }])",
     "columns": [
      {
       "selector": "k",
       "text": "k",
       "type": "number"
      },
      {
       "selector": "v",
       "text": "vB",
       "type": "number"
      }
     ],
     "filters": [],
     "datasource": {
      "type": "yesoreyeram-infinity-datasource",
