+        raise ValueError('p6_probability_scaler_invalid')
+    x=np.column_stack((x,(p-scale['mean'])/scale['scale'])).astype(np.float32)
+    if x.shape!=(len(rows),31) or not np.isfinite(x).all():raise ValueError('p6_matrix_invalid')
