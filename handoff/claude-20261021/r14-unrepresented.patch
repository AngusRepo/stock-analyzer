@@ -0,0 +1,69 @@
+from pathlib import Path
+import sys
+
+import numpy as np
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from services.active8_oof_stacker import _fit_ridge, fit_qualified_prior_ridge, RIDGE_CANDIDATES
+
+ORDER = ("LightGBM", "XGBoost", "ExtraTrees", "TabM", "GNN", "TimeXer", "PatchTST", "iTransformer")
+
+
+def fixture():
+    rng = np.random.default_rng(144)
+    x = rng.uniform(size=(1000, 16))
+    x[:, 8:] = rng.integers(0, 2, size=(1000, 8))
+    y = .10 * x[:, 5] + .02 * x[:, 1] - .03 * x[:, 10]
+    prior = np.array([1 / 6] * 5 + [0., 0., 1 / 6])
+    return x, y, prior
+
+
+def test_zero_prior_exactly_reproduces_historical_fit():
+    x, y, _ = fixture()
+    a = _fit_ridge(x, y, 1., model_order=ORDER)
+    b = _fit_ridge(x, y, 1., model_order=ORDER, rank_prior=np.zeros(8))
+    np.testing.assert_array_equal(a[0], b[0])
+    assert a[1] == b[1]
+
+
+def test_prior_solution_obeys_kkt_and_keeps_degraded_model_estimable():
+    x, y, prior = fixture()
+    weights, intercept = _fit_ridge(x, y, 10., model_order=ORDER, rank_prior=prior)
+    mean, scale = x.mean(axis=0), x.std(axis=0)
+    z = (x - mean) / scale
+    theta = weights * scale
+    theta0 = np.r_[prior, np.zeros(8)]
+    residual = x @ weights + intercept - y
+    gradient = z.T @ residual + 10 * (theta - theta0)
+    free = np.r_[theta[:8] > 1e-8, np.ones(8, dtype=bool)]
+    assert np.max(np.abs(gradient[free])) < 1e-6
+    assert np.all(gradient[:8][~free[:8]] > -1e-6)
+    assert abs(residual.sum()) < 1e-6
+    assert weights[5] > 0  # zero prior is not a model exclusion
+    assert weights[10] < 0  # availability remains unbounded
+
+
+def test_large_lambda_converges_to_standardized_prior():
+    x, y, prior = fixture()
+    weights, _ = _fit_ridge(x, y, 1e10, model_order=ORDER, rank_prior=prior)
+    np.testing.assert_allclose(weights * x.std(axis=0), np.r_[prior, np.zeros(8)], atol=1e-7)
+
+
+@pytest.mark.parametrize("prior", ([.1] * 7, [float('nan')] * 8, [-.1] * 8))
+def test_invalid_prior_fails_explicitly(prior):
+    x, y, _ = fixture()
+    with pytest.raises(ValueError, match='rank_prior_invalid'):
+        _fit_ridge(x, y, 1., model_order=ORDER, rank_prior=prior)
+
+
+def test_candidate_requires_distinct_inner_prior_and_existing_lambda_set():
+    x, y, prior = fixture()
+    days = np.array([f'2026-01-{i // 50 + 1:02d}' for i in range(1000)])
+    known = np.array([f'2026-01-{i // 50 + 3:02d}' for i in range(1000)])
+    markets = np.full(1000, 'TW')
+    result = fit_qualified_prior_ridge(x, y, days, markets, label_known_dates=known,
+                                     model_order=ORDER, rank_prior=prior, inner_rank_prior=np.zeros(8))
+    assert result[2] in RIDGE_CANDIDATES
+    with pytest.raises(TypeError):
+        fit_qualified_prior_ridge(x, y, days, markets, label_known_dates=known, model_order=ORDER, rank_prior=prior)
