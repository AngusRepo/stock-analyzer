+import { paperAccountId } from '../paperExecutionScope'
+/**
+ * accountDrawdownPause.ts — account-level stop of new entries.
+ *
+ * Peak NAV is taken from trading:risk_config.portfolio.accountDrawdownBaselineDate
+ * (activation / real account start), never a rolling window. This is the only
+ * drawdown check with stop-trading authority; P1 only scales position size.
+ */
+import type { RiskConfig } from '../riskConfig'
+import type { CircuitBreakerState, LegacyLayerDeps, LegacyLayerResult } from '../riskTypes'
+import { failClosedRiskCheck } from './failClosed'
+
+export async function checkAccountDrawdownPause(
+  db: D1Database,
+  riskCfg: RiskConfig,
+  deps: LegacyLayerDeps,
+  current?: { tradeDate: string; nav: number },
+): Promise<LegacyLayerResult> {
+  const { accountDrawdownPause: limit, accountDrawdownBaselineDate: baseline } = riskCfg.portfolio
+  if (baseline == null) return null
+  try {
+    if (!/^\d{4}-\d{2}-\d{2}$/.test(baseline) || !Number.isFinite(limit) || limit <= -1 || limit >= 0)
+      throw new Error('account_drawdown_config_invalid')
+    if (current && (!/^\d{4}-\d{2}-\d{2}$/.test(current.tradeDate) || !Number.isFinite(current.nav) || current.nav <= 0))
+      throw new Error('account_drawdown_context_invalid')
+    const upTo = current?.tradeDate ?? '9999-12-31'
+    const { results } = await db.prepare(
+      'SELECT date, total_value FROM paper_daily_snapshots WHERE account_id=? AND date>=? AND date<=? ORDER BY date'
+    ).bind(paperAccountId(), baseline, upTo).all<{ date: string; total_value: number }>()
+    const values = (results ?? []).map(r => Number(r.total_value))
+    if (values.some(v => !Number.isFinite(v) || v <= 0)) throw new Error('account_drawdown_snapshot_invalid')
+    if (current) values.push(current.nav)
+    if (!values.length) return null
+    const peak = Math.max(...values)
+    const nav = values[values.length - 1]
+    const drawdown = nav / peak - 1
+    if (drawdown > limit) return null
+    console.warn(`[AccountDrawdown] pause: drawdown ${(drawdown * 100).toFixed(2)}% <= ${(limit * 100).toFixed(2)}% since ${baseline}`)
+    const state: CircuitBreakerState = {
+      halt: true,
+      reason: `【帳戶回撤】自 ${baseline} 高點 ${peak.toFixed(0)} 回撤 ${(drawdown * 100).toFixed(2)}%，達暫停線 ${(limit * 100).toFixed(1)}%`,
+      maxPositionPct: 0,
+      buyConfThreshold: deps.defaults.buyConfThreshold,
+      sellConfThreshold: deps.defaults.sellConfThreshold,
+    }
+    return state
+  } catch (error) { return failClosedRiskCheck('ACCOUNT_DD', error, deps) }
+}
