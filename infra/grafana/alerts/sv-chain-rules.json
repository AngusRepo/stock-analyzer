    {
     "uid": "sv-monitoring-silent",
     "title": "監控端點拿不到資料",
     "condition": "C",
     "for": "5m",
     "isPaused": true,
     "noDataState": "Alerting",
     "execErrState": "Alerting",
     "labels": {
      "severity": "critical",
      "system": "stockvision",
      "source": "monitoring-worker"
     },
     "annotations": {
      "summary": "監控 Worker 沒有回應或回應格式不對；其他規則此時無法判斷。",
