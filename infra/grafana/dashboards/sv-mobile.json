    },
    {
     "refId": "C",
     "type": "json",
     "parser": "backend",
     "format": "table",
     "root_selector": "([{ 'k': 1, 'v': $count(checks[status = 'fail']) + $count(rows[status = 'blocked']) > 0 ? 1 : 0 }])",
     "columns": [
      {
       "selector": "k",
       "text": "k",
       "type": "number"
      },
      {
       "selector": "v",
       "text": "vC",
       "type": "number"
      }
     ],
     "filters": [],
