     },
     "source": "url",
     "url": "/v1/data-readiness",
     "url_options": {
      "method": "GET",
      "data": ""
     }
    }
   ],
   "transformations": [
    {
     "id": "joinByField",
     "options": {
      "byField": "k",
      "mode": "outer"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "k": true
      },
      "indexByName": {
       "vA A": 0,
       "vB B": 1,
       "vC C": 2
      },
      "renameByName": {
       "vA A": "vA",
       "vB B": "vB",
       "vC C": "vC"
      }
     }
    },
    {
     "id": "calculateField",
     "options": {
      "mode": "reduceRow",
      "reduce": {
       "reducer": "max",
       "include": [
        "vA",
        "vB",
        "vC"
       ]
      },
      "alias": "max"
     }
    },
    {
     "id": "calculateField",
     "options": {
      "mode": "reduceRow",
      "reduce": {
       "reducer": "count",
       "include": [
        "vA",
        "vB",
        "vC"
       ]
      },
      "alias": "answered"
     }
    },
    {
     "id": "calculateField",
     "options": {
      "mode": "binary",
      "binary": {
       "left": "answered",
       "operator": "*",
       "right": "-10"
      },
      "alias": "missing",
      "replaceFields": false
     }
    },
    {
     "id": "calculateField",
     "options": {
      "mode": "binary",
      "binary": {
       "left": "max",
       "operator": "+",
       "right": "missing"
      },
      "alias": "shifted",
      "replaceFields": false
     }
    },
    {
     "id": "calculateField",
     "options": {
      "mode": "binary",
      "binary": {
       "left": "shifted",
       "operator": "+",
       "right": "30"
      },
      "alias": "判斷",
      "replaceFields": true
     }
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "/.*/",
     "values": false
    },
    "orientation": "auto",
    "textMode": "value",
    "wideLayout": false,
    "colorMode": "value",
    "graphMode": "none",
    "justifyMode": "auto",
    "showPercentChange": false,
