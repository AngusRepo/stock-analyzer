FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /app

RUN python -m pip install --no-cache-dir --upgrade pip==26.1.2 setuptools==83.0.0

RUN groupadd --system stockvision \
    && useradd --system --gid stockvision --home-dir /app stockvision

COPY ml-controller/requirements-execution-gateway.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

COPY --chown=stockvision:stockvision ml-controller/execution_gateway_app.py /app/execution_gateway_app.py
COPY --chown=stockvision:stockvision ml-controller/services/__init__.py /app/services/__init__.py
COPY --chown=stockvision:stockvision ml-controller/services/broker_execution_contract.py /app/services/broker_execution_contract.py
COPY --chown=stockvision:stockvision ml-controller/services/broker_execution_repository.py /app/services/broker_execution_repository.py
COPY --chown=stockvision:stockvision ml-controller/services/execution_d1_client.py /app/services/execution_d1_client.py
COPY --chown=stockvision:stockvision ml-controller/services/execution_snapshot_revalidator.py /app/services/execution_snapshot_revalidator.py
COPY --chown=stockvision:stockvision ml-controller/services/finlab_execution_adapter.py /app/services/finlab_execution_adapter.py
COPY --chown=stockvision:stockvision ml-controller/services/finlab_execution_gateway.py /app/services/finlab_execution_gateway.py
COPY --chown=stockvision:stockvision ml-controller/services/finlab_execution_shadow_service.py /app/services/finlab_execution_shadow_service.py
COPY --chown=stockvision:stockvision ml-controller/services/finlab_execution_preview_service.py /app/services/finlab_execution_preview_service.py
COPY --chown=stockvision:stockvision ml-controller/services/finlab_live_submit_service.py /app/services/finlab_live_submit_service.py
COPY --chown=stockvision:stockvision ml-controller/services/finlab_sinopac_l5_market_data.py /app/services/finlab_sinopac_l5_market_data.py
COPY --chown=stockvision:stockvision ml-controller/services/kv_client.py /app/services/kv_client.py

USER stockvision
EXPOSE 8080

CMD ["uvicorn", "execution_gateway_app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--log-level", "info"]
